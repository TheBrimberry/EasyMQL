# Trading Assistant API Environment Configuration
# Copy this file to .env and fill in your values

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# LLM Provider Settings
# Options: 'openai', 'anthropic', 'local', 'huggingface'
LLM_PROVIDER=local

# API Keys (fill in the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Local Model Path (for local LLM)
LOCAL_MODEL_PATH=

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Redis Cache (optional)
REDIS_URL=

# Database (optional)
DATABASE_URL=
